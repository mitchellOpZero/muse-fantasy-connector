# Copy to .env for local dev. Never commit a real .env.
# Nothing here is required to run: the connector degrades with honest
# "not configured" answers instead of crashing.

# Public base URL of the deployed connector (used in docs links only).
PUBLIC_URL=https://ff.muse.example.com

# Where users subscribe / manage billing. Placeholder until Stripe is wired.
PAYMENT_URL=https://ff.muse.example.com/subscribe
PRICING_URL=https://github.com/mitchellOpZero/muse-fantasy-connector/blob/main/PRICING.md
SUPPORT_EMAIL=support@example.com

# Subjects (Muse user ids / emails from the Authorization bearer or
# x-muse-subject header) that hold paid tiers. Comma-separated.
# Production should sync these from Stripe webhooks into durable storage;
# the env list is the scaffold. Empty = everyone is on Free.
PREMIUM_SUBJECTS=
COMMISSIONER_SUBJECTS=

# Yahoo OAuth app (only needed for private Yahoo leagues).
# Register at https://sports.yahoo.com/developer/ with redirect URI
# <PUBLIC_URL>/v1/yahoo/callback and request read-only fspt-r scope.
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
YAHOO_REDIRECT_URI=

# Stripe billing webhook (paid tiers unlock via webhook-synced entitlements).
# One-time setup: in the Stripe dashboard create a webhook endpoint pointing at
# <PUBLIC_URL>/v1/billing/webhook, subscribe it to checkout.session.completed,
# customer.subscription.created, customer.subscription.updated,
# customer.subscription.deleted, and invoice.payment_failed, then store the
# endpoint's signing secret here (Vercel: env var on the production deployment).
STRIPE_WEBHOOK_SECRET=
# Checkout amounts (cents, USD) that identify each tier on the webhook.
# Defaults match the live payment links: Pro $8/mo, Commissioner $25/mo.
STRIPE_PRO_AMOUNT_CENTS=800
STRIPE_COMMISSIONER_AMOUNT_CENTS=2500

# Vercel KV (Upstash Redis) for durable tier entitlements in production.
# Absent locally: entitlements live in memory and die with the process.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Bearer token guarding the read-only /v1/billing/events audit log.
BILLING_ADMIN_SECRET=

# Rate limit: requests per minute per client IP on /mcp.
RATE_LIMIT_PER_MIN=600

PORT=8102
